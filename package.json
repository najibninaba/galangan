{
  "name": "galangan",
  "version": "0.2.6",
  "description": "Galangan: a harness app shell on Pi Durable and Effect, for building custom agent harnesses",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najibninaba/galangan.git"
  },
  "homepage": "https://github.com/najibninaba/galangan#readme",
  "type": "module",
  "exports": {
    ".": {
      "galangan-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "galangan-source": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./kit/memory": {
      "galangan-source": "./src/kit/memory/index.ts",
      "default": "./dist/kit/memory/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "start": "NODE_OPTIONS=\"--conditions=galangan-source $NODE_OPTIONS\" node examples/tally/main.ts",
    "check": "tsc -p . && tsc -p tsconfig.build.json --noEmit",
    "test": "NODE_OPTIONS=\"--conditions=galangan-source $NODE_OPTIONS\" node --test --test-reporter=spec \"test/**/*.test.ts\" \"examples/**/*.test.ts\"",
    "smoke:real": "NODE_OPTIONS=\"--conditions=galangan-source $NODE_OPTIONS\" node test/real-model-smoke.ts",
    "smoke:recovery": "NODE_OPTIONS=\"--conditions=galangan-source $NODE_OPTIONS\" node test/real-model-recovery.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@types/node": "26.6.5",
    "effect": "4.1.4",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "effect": "4.1.4"
  }
}

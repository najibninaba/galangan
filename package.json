{
  "name": "galangan",
  "version": "0.1.0",
  "private": true,
  "description": "Galangan: a harness app shell on Pi Durable and Effect, for building custom agent harnesses",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "start": "node examples/tally/main.ts",
    "check": "tsc -p .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\" \"examples/**/*.test.ts\"",
    "smoke:real": "node test/real-model-smoke.ts",
    "smoke:recovery": "node test/real-model-recovery.ts"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@types/node": "26.6.5",
    "effect": "4.1.4",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "effect": "4.1.4"
  }
}

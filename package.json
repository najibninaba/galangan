{
  "name": "galangan",
  "version": "0.0.0",
  "private": true,
  "description": "Galangan: a harness app shell on Pi Durable and Effect, for building custom agent harnesses",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc -p .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "smoke:real": "node test/real-model-smoke.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
